# Public URL used in links returned by the API. Include https:// in production.
OXBIN_BASE_URL=http://localhost:8080

# Bind the published container port to loopback by default. Set 0.0.0.0 only
# when the service should accept direct connections from the host network.
OXBIN_HOST_BIND=127.0.0.1

# Paste limits, expiry choices, and per-client request rates.
OXBIN_MAX_PASTE_BYTES=1048576
OXBIN_DEFAULT_EXPIRY=24h
OXBIN_ALLOWED_EXPIRIES=1h,24h,72h
OXBIN_CREATE_RATE=15/1h
OXBIN_READ_RATE=120/1h
OXBIN_MISS_RATE=30/1h
OXBIN_CONSUME_RATE=30/1h

# Only trust proxy addresses that directly connect to 0xbin. Leave empty for
# direct access. The hosted Docker bridge gateway is 172.18.0.1/32.
OXBIN_TRUSTED_PROXIES=

# Emergency creation switch. Changes take effect after container recreation.
# Reads, burn consumes, and existing live sessions remain available when false.
OXBIN_CREATION_ENABLED=true

# HTTP server timeouts.
OXBIN_READ_HEADER_TIMEOUT=5s
OXBIN_READ_TIMEOUT=15s
OXBIN_WRITE_TIMEOUT=30s
OXBIN_IDLE_TIMEOUT=60s
OXBIN_SHUTDOWN_TIMEOUT=10s

# Set false to serve bare pastes without live routes or the LiveBin UI.
OXBIN_LIVE_ENABLED=true

# Live sharing safety limits. Room lifetime defaults to the settled 24 hours.
OXBIN_LIVE_ROOM_LIFETIME=24h
OXBIN_LIVE_MAX_TABS=8
OXBIN_LIVE_MAX_BYTES=1048576
OXBIN_LIVE_MAX_WRITERS=10
OXBIN_LIVE_MAX_VIEWERS=100
OXBIN_LIVE_MAX_PARTICIPANTS=110
OXBIN_LIVE_MAX_MESSAGE_BYTES=65536
OXBIN_LIVE_HEARTBEAT_INTERVAL=20s
OXBIN_LIVE_RECONNECT_GRACE=30s
OXBIN_LIVE_PARTICIPANT_TIMEOUT=60s
OXBIN_LIVE_CREATE_RATE=10/1h
OXBIN_LIVE_UNLOCK_RATE=10/15m
OXBIN_LIVE_CONNECTION_RATE=60/1m
OXBIN_LIVE_MESSAGE_RATE=2400/1m
OXBIN_LIVE_MAX_CONNECTIONS=1000
# Snapshot history rows / serialized bytes.
OXBIN_LIVE_SNAPSHOT_LIMITS=1000/4194304

# Public URL used in links returned by the API. Include https:// in production.
OXBIN_BASE_URL=http://localhost:8080

# Set false to serve bare pastes without live routes or the LiveBin UI.
OXBIN_LIVE_ENABLED=true

# Live sharing safety limits. Room lifetime defaults to the settled 24 hours.
OXBIN_LIVE_ROOM_LIFETIME=24h
OXBIN_LIVE_MAX_TABS=8
OXBIN_LIVE_MAX_BYTES=1048576
OXBIN_LIVE_MAX_WRITERS=10
OXBIN_LIVE_MAX_VIEWERS=100
OXBIN_LIVE_MAX_PARTICIPANTS=110
OXBIN_LIVE_MAX_MESSAGE_BYTES=65536
OXBIN_LIVE_HEARTBEAT_INTERVAL=20s
OXBIN_LIVE_RECONNECT_GRACE=30s
OXBIN_LIVE_PARTICIPANT_TIMEOUT=60s
OXBIN_LIVE_CREATE_RATE=10/1h
OXBIN_LIVE_UNLOCK_RATE=10/15m
OXBIN_LIVE_CONNECTION_RATE=60/1m
OXBIN_LIVE_MESSAGE_RATE=2400/1m
OXBIN_LIVE_MAX_CONNECTIONS=1000
# Snapshot history rows / serialized bytes.
OXBIN_LIVE_SNAPSHOT_LIMITS=1000/4194304
